#!/usr/bin/env -S sudo -Es bpftrace

BEGIN
{
  printf("Hit Ctrl-C to generate the %s report\n", str($1));
}

uprobe:$1:$2
{
  @stack[tid]++;
  @start[tid, @stack[tid]] = nsecs;
  @bt[tid, @stack[tid]] = ustack(perf);
}

uretprobe:$1:$2
/@stack[tid] > 0/
{
  @[@bt[tid,@stack[tid]], tid] = hist(nsecs - @start[tid, @stack[tid]]) ;
  @stack[tid]--;
}

END
{
  clear(@stack);
  clear(@start);
  clear(@bt);
}
