[user]
	name = Joe Schaefer
	email = jschaefer@cleardemand.com
	signingkey = C:\\Users\\jschaefer\\.ssh\\id_ed25519_sk.pub
[clean]
	requireForce = 1
[push]
	default = current
[github]
	user = joesuf4
[log]
#        showSignature = true
[pull]
	rebase = true
        verifySignatures = true
[commit]
	gpgsign = true
[tag]
        gpgsign = true
[http]
        sslCAinfo = /etc/certs/ca-certificates.crt
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed-signers
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
